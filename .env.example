# 火山方舟
ARK_API_KEY=
ARK_MODEL=
# 可选，默认 https://ark.cn-beijing.volces.com/api/v3
ARK_BASE_URL=
# SQLite 文件路径，默认 ./data/suanming.db
DATABASE_URL=
# better-auth 会话签名密钥（openssl rand -hex 32 生成）
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# 每用户每日 LLM 调用上限
DAILY_LLM_LIMIT=20
# 向量召回用的 embedding 模型（走方舟 /embeddings/multimodal 端点；未开通时向量召回自动跳过，其余记忆层不受影响）
ARK_EMBEDDING_MODEL=doubao-embedding-vision-250615
ASR_API_KEY=
# 可选，默认 volc.bigasr.sauc.duration（豆包流式语音识别 1.0 小时版）
ASR_RESOURCE_ID=
